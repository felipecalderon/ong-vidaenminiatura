generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  USUARIO
  AUTOR
  ADMINISTRADOR
}

enum EstadoUsuario {
  ACTIVO
  SUSPENDIDO
}

enum EstadoPeticion {
  BORRADOR
  REVISION
  PUBLICADA
  CERRADA
  ARCHIVADA
}

enum EstadoNoticia {
  BORRADOR
  REVISION
  PUBLICADA
  ARCHIVADA
}

enum TipoPublicacion {
  ESTUDIO
  PUBLICACION
  EVENTO
}

enum EstadoPublicacion {
  BORRADOR
  REVISION
  PUBLICADA
  ARCHIVADA
}

enum TipoRecursoEducativo {
  CONCEPTO
  GUIA
  PREGUNTA
  ACCION
}

enum EstadoRecursoEducativo {
  BORRADOR
  REVISION
  PUBLICADA
  ARCHIVADA
}

model usuario {
  id                  String        @id @default(uuid()) @db.Uuid
  auth0_id            String        @unique
  correo              String        @unique
  nombre              String
  nickname            String?
  given_name          String?
  family_name         String?
  picture             String?
  email_verified      Boolean?
  rol                 Rol           @default(USUARIO)
  estado              EstadoUsuario @default(ACTIVO)
  fecha_creacion      DateTime      @default(now())
  fecha_actualizacion DateTime      @updatedAt

  peticiones peticion[]
  noticias   noticia[] @relation("AutorNoticias")
  publicaciones publicacion[] @relation("AutorPublicaciones")
  recursosEducativos recursoEducativo[] @relation("AutorRecursosEducativos")
  firmas     firma[]

  @@index([rol])
  @@index([estado])
}

model categoria {
  id             String     @id @default(uuid()) @db.Uuid
  nombre         String     @unique
  slug           String     @unique
  descripcion    String?
  color          String?
  activo         Boolean    @default(true)
  fecha_creacion DateTime   @default(now())
  fecha_actualizacion DateTime @updatedAt

  peticiones peticion[]
  noticias   noticia[]
  recursosEducativos recursoEducativo[]

  @@index([activo])
}

model peticion {
  id                  String         @id @default(uuid()) @db.Uuid
  titulo              String
  slug                String         @unique
  resumen             String
  contenido           String
  imagen              String?
  estado              EstadoPeticion @default(BORRADOR)
  cantidad_firmas     Int            @default(0)
  meta_firmas         Int            @default(1000)
  categoria_id        String         @db.Uuid
  usuario_id          String         @db.Uuid
  fecha_publicacion   DateTime?
  destacado           Boolean        @default(false)
  fecha_creacion      DateTime       @default(now())
  fecha_actualizacion DateTime       @updatedAt

  categoria categoria @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  usuario   usuario   @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  firmas    firma[]

  @@index([estado, fecha_publicacion])
  @@index([categoria_id])
  @@index([usuario_id])
  @@index([usuario_id, fecha_creacion])
  @@index([cantidad_firmas])
}

model firma {
  id             String   @id @default(uuid()) @db.Uuid
  usuario_id     String   @db.Uuid
  peticion_id    String   @db.Uuid
  fecha_creacion DateTime @default(now())

  usuario  usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  peticion peticion @relation(fields: [peticion_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, peticion_id])
  @@index([usuario_id])
  @@index([peticion_id])
}

model noticia {
  id                  String         @id @default(uuid()) @db.Uuid
  titulo              String
  slug                String         @unique
  resumen             String
  contenido           String
  imagen              String?
  estado              EstadoNoticia  @default(BORRADOR)
  categoria_id        String         @db.Uuid
  autor_id            String         @db.Uuid
  fecha_publicacion   DateTime?
  destacado           Boolean        @default(false)
  fecha_creacion      DateTime       @default(now())
  fecha_actualizacion DateTime       @updatedAt

  categoria categoria @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  autor     usuario   @relation("AutorNoticias", fields: [autor_id], references: [id], onDelete: Restrict)

  @@index([estado, fecha_publicacion])
  @@index([categoria_id])
  @@index([autor_id])
  @@index([autor_id, fecha_creacion])
}

model publicacion {
  id                  String             @id @default(uuid()) @db.Uuid
  titulo              String
  slug                String             @unique
  resumen             String
  contenido           String
  imagen              String?
  tipo                TipoPublicacion
  autores             String[]
  anio                Int?
  enlace              String?
  lugar               String?
  fecha_evento        DateTime?
  estado              EstadoPublicacion  @default(BORRADOR)
  autor_id            String             @db.Uuid
  fecha_publicacion   DateTime?
  destacado           Boolean            @default(false)
  fecha_creacion      DateTime           @default(now())
  fecha_actualizacion DateTime           @updatedAt

  autor usuario @relation("AutorPublicaciones", fields: [autor_id], references: [id], onDelete: Restrict)

  @@index([estado, fecha_publicacion])
  @@index([tipo])
  @@index([autor_id])
}

model recursoEducativo {
  id                  String                   @id @default(uuid()) @db.Uuid
  titulo              String
  slug                String                   @unique
  resumen             String
  contenido           String
  imagen              String?
  tipo                TipoRecursoEducativo
  categoria_id        String?                  @db.Uuid
  estado              EstadoRecursoEducativo   @default(BORRADOR)
  autor_id            String                   @db.Uuid
  fecha_publicacion   DateTime?
  destacado           Boolean                  @default(false)
  fecha_creacion      DateTime                 @default(now())
  fecha_actualizacion DateTime                 @updatedAt

  categoria categoria? @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  autor     usuario   @relation("AutorRecursosEducativos", fields: [autor_id], references: [id], onDelete: Restrict)

  @@index([estado, fecha_publicacion])
  @@index([tipo])
  @@index([autor_id])
}

